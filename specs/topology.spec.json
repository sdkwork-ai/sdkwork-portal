{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-portal",
  "applicationCode": "portal",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production",
    "gatewayBind": "127.0.0.1:18091"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_PORTAL_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_PORTAL_ENVIRONMENT",
    "profileId": "SDKWORK_PORTAL_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_PORTAL_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_PORTAL_APPLICATION_PUBLIC_INGRESS_BIND",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_PORTAL_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_PORTAL_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_PORTAL_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_PORTAL_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_PORTAL_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_PORTAL_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_PORTAL_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
