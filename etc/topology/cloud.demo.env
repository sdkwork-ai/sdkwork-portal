# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_portal_demo` (table
# prefix `platform_`) and a dedicated Redis logical DB index so no cache key collides with another
# shared-redis environment.
SDKWORK_PORTAL_DEPLOYMENT_PROFILE=cloud
SDKWORK_PORTAL_ENVIRONMENT=demo
SDKWORK_PORTAL_PROFILE_ID=cloud.demo
SDKWORK_PORTAL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_PORTAL_APPLICATION_PUBLIC_HTTP_URL=https://portal-demo.sdkwork.com
VITE_SDKWORK_PORTAL_APPLICATION_PUBLIC_HTTP_URL=https://portal-demo.sdkwork.com
VITE_SDKWORK_PORTAL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_PORTAL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://portal-demo.sdkwork.com,http://portal-demo.sdkwork.com,https://portal-demo.birdcoder.com,http://portal-demo.birdcoder.com,https://portal-demo.dtupay.com,http://portal-demo.dtupay.com,https://portal-demo.noaper.com,http://portal-demo.noaper.com,https://portal-demo.sdkwork.cn,http://portal-demo.sdkwork.cn,https://portal-demo.birdcoder.cn,http://portal-demo.birdcoder.cn,https://portal-demo.dtupay.cn,http://portal-demo.dtupay.cn,https://portal-demo.noaper.cn,http://portal-demo.noaper.cn,https://portal-demo.skubc.com,http://portal-demo.skubc.com,https://portal-demo.skubc.cn,http://portal-demo.skubc.cn,https://portal-demo.zowalk.com,http://portal-demo.zowalk.com,https://portal-demo.zowalk.cn,http://portal-demo.zowalk.cn,https://portal-demo.offer86.com,http://portal-demo.offer86.com,https://portal-demo.offer86.cn,http://portal-demo.offer86.cn,https://portal-demo.86offer.com,http://portal-demo.86offer.com,https://portal-demo.86offer.cn,http://portal-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
