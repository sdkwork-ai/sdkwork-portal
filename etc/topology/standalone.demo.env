# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_portal_demo` (table
# prefix `platform_`) and a dedicated Redis logical DB index so that no cache key (rate-limit,
# session, idempotency) ever collides with another shared-redis environment.
SDKWORK_PORTAL_DEPLOYMENT_PROFILE=standalone
SDKWORK_PORTAL_ENVIRONMENT=demo
SDKWORK_PORTAL_PROFILE_ID=standalone.demo
SDKWORK_PORTAL_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18073
SDKWORK_PORTAL_APPLICATION_PUBLIC_HTTP_URL=http://portal-demo.sdkwork.com:18073
VITE_SDKWORK_PORTAL_APPLICATION_PUBLIC_HTTP_URL=http://portal-demo.sdkwork.com:18073

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_PORTAL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
